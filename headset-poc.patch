+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Neurocinema status</title>
+<style>
+  :root {
+    --bg: #f6f5f2; --card: #ffffff; --ink: #1d1d1b; --quiet: #6b6a66; --line: #dddbd5;
+    --ok: #1f7a4d; --ok-bg: #e3f3ea; --warn: #9a5b00; --warn-bg: #fdf0d9;
+    --bad: #a8261b; --bad-bg: #fbe3e0; --accent: #2457c5;
+  }
+  @media (prefers-color-scheme: dark) {
+    :root {
+      --bg: #161615; --card: #20201f; --ink: #f1f0ec; --quiet: #a3a29d; --line: #3a3936;
+      --ok: #5cc98f; --ok-bg: #173526; --warn: #f0b54d; --warn-bg: #3a2c12;
+      --bad: #f2786c; --bad-bg: #3d1a17; --accent: #7aa2ff;
+    }
+  }
+  * { box-sizing: border-box; }
+  body { margin: 0; background: var(--bg); color: var(--ink);
+         font: 17px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
+  main { max-width: 760px; margin: 0 auto; padding: 20px 16px 48px; }
+  .banner { border-radius: 14px; padding: 22px 20px; margin-bottom: 18px; border: 2px solid transparent; }
+  .banner h1 { margin: 0; font-size: 28px; line-height: 1.2; }
+  .banner p { margin: 8px 0 0; color: var(--quiet); }
+  .ok   { background: var(--ok-bg);   border-color: var(--ok); }
+  .ok h1 { color: var(--ok); }
+  .swap_soon { background: var(--warn-bg); border-color: var(--warn); }
+  .swap_soon h1 { color: var(--warn); }
+  .offline { background: var(--bad-bg); border-color: var(--bad); }
+  .offline h1 { color: var(--bad); }
+  .action { background: var(--card); border-color: var(--accent); }
+  .action h1 { color: var(--accent); }
+  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: .04em; color: var(--quiet); margin: 26px 0 10px; }
+  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 12px; }
+  .hs { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px; }
+  .hs.in-use { border: 2px solid var(--ok); }
+  .hs .label { font-size: 34px; font-weight: 700; line-height: 1; }
+  .hs .meta { color: var(--quiet); font-size: 14px; margin: 6px 0 10px; min-height: 40px; }
+  button { font: inherit; border-radius: 10px; border: 1px solid var(--line); background: var(--card);
+           color: var(--ink); padding: 10px 14px; cursor: pointer; width: 100%; }
+  button.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
+  button:disabled { opacity: .45; cursor: default; }
+  .row { display: flex; gap: 10px; flex-wrap: wrap; }
+  .row button { width: auto; }
+  .small { color: var(--quiet); font-size: 14px; }
+  code { font-size: 13px; }
+  #conn { display: none; }
+</style>
+</head>
+<body>
+<main>
+  <div id="banner" class="banner"><h1 id="headline">Loading…</h1><p id="detail"></p></div>
+  <p id="conn" class="small">Cannot reach the engine. Is the computer on and nc-engine running?</p>
+
+  <h2>Headsets</h2>
+  <div id="headsets" class="grid"></div>
+  <p class="small">To swap: wait until nobody wears the headset, switch the old one off and put it on the charger,
+    switch a charged one on, tap its letter here, then pick it up.</p>
+
+  <h2>Tools</h2>
+  <div class="row">
+    <button id="reconnect">Reconnect</button>
+    <button id="release">Stop using headset</button>
+    <button id="sound">Turn on alert sound</button>
+  </div>
+  <div id="unknown"></div>
+</main>
+<script>
+const $ = (id) => document.getElementById(id);
+let soundOn = false, audio = null, lastAlert = "ok", lastBeep = 0, current = null;
+
+function beep() {
+  if (!soundOn || !audio) return;
+  const o = audio.createOscillator(), g = audio.createGain();
+  o.frequency.value = 880; g.gain.value = 0.15;
+  o.connect(g); g.connect(audio.destination);
+  o.start(); o.stop(audio.currentTime + 0.35);
+}
+
+$("sound").onclick = () => {
+  soundOn = !soundOn;
+  if (soundOn && !audio) audio = new (window.AudioContext || window.webkitAudioContext)();
+  $("sound").textContent = soundOn ? "Turn off alert sound" : "Turn on alert sound";
+  if (soundOn) beep();
+};
+
+async function post(path, body) {
+  await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" },
+                      body: JSON.stringify(body || {}) });
+  refresh();
+}
+$("reconnect").onclick = () => post("/api/reconnect");
+$("release").onclick = () => {
+  if (confirm("Stop using the current headset?")) post("/api/release");
+};
+
+function ago(s) {
+  if (s === null || s === undefined) return null;
+  if (s < 90) return `${s} s ago`;
+  if (s < 5400) return `${Math.round(s / 60)} min ago`;
+  return `${(s / 3600).toFixed(1)} h ago`;
+}
+
+function render(s) {
+  const busy = s.phase === "connecting" || s.phase === "confirming";
+  $("banner").className = "banner " + (busy && s.alert !== "offline" ? "action" : s.alert);
+  $("headline").textContent = busy ? s.message : s.headline;
+  $("detail").textContent = busy || s.headline === s.message ? "" : s.message;
+
+  current = s.current;
+  const box = $("headsets");
+  box.replaceChildren(...s.headsets.map((h) => {
+    const card = document.createElement("div");
+    card.className = "hs" + (h.in_use ? " in-use" : "");
+    const meta = [];
+    if (h.in_use) meta.push("In use");
+    else if (h.chosen) meta.push("Chosen");
+    if (h.battery !== null) meta.push(`${h.battery} %` + (h.in_use ? "" : ` (${ago(h.battery_s_ago)})`));
+    if (h.minutes_left !== null && h.in_use) meta.push(`about ${h.minutes_left} min left`);
+    if (!h.chosen && h.seen_s_ago !== null) meta.push(h.seen_s_ago < 30 ? "switched on" : `seen ${ago(h.seen_s_ago)}`);
+    card.innerHTML = `<div class="label"></div><div class="meta"></div>`;
+    card.querySelector(".label").textContent = h.label;
+    card.querySelector(".meta").textContent = meta.join(" · ") || "Not seen yet";
+    const b = document.createElement("button");
+    b.textContent = h.chosen ? (h.in_use ? "In use" : "Waiting…") : `Use headset ${h.label}`;
+    b.className = h.chosen ? "" : "primary";
+    b.disabled = h.chosen;
+    b.onclick = () => {
+      if (!current || confirm(`Switch from headset ${current} to ${h.label}? Only do this between visitors.`))
+        post("/api/select", { label: h.label });
+    };
+    card.appendChild(b);
+    return card;
+  }));
+
+  const unk = $("unknown");
+  unk.innerHTML = "";
+  if (s.unknown.length) {
+    const p = document.createElement("p");
+    p.className = "small";
+    p.textContent = "Other Muse headsets nearby (not registered, never used): " + s.unknown.join(", ") +
+      ". To add one, put e.g. \"E=" + s.unknown[0] + "\" in headsets.registry in config/local.toml.";
+    unk.appendChild(p);
+  }
+
+  if (s.alert !== "ok" && (s.alert !== lastAlert || Date.now() - lastBeep > 300000)) {
+    beep(); lastBeep = Date.now();
+  }
+  lastAlert = s.alert;
+}
+
+async function refresh() {
+  try {
+    const r = await fetch("/api/status", { cache: "no-store" });
+    render(await r.json());
+    $("conn").style.display = "none";
+  } catch (e) {
+    $("conn").style.display = "block";
+    $("banner").className = "banner offline";
+    $("headline").textContent = "Status page lost contact with the engine";
+  }
+}
+refresh();
+setInterval(refresh, 1000);
+</script>
+</body>
+</html>
diff --git a/b/src/neurocinema/statuspage.py b/src/neurocinema/statuspage.py
new file mode 100644
index 0000000..613a54c
--- /dev/null
+++ b/src/neurocinema/statuspage.py
@@ -0,0 +1,95 @@
+"""Local status page for staff: one page, a few buttons, no internet needed.
+
+    GET  /             the page
+    GET  /api/status   the headset manager's snapshot (JSON)
+    POST /api/select   {"label": "B"}   use headset B (staff then lift it)
+    POST /api/release  stop using the current headset
+    POST /api/reconnect
+
+Runs on its own thread; commands are queued to the main loop.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from importlib.resources import files
+
+from .headsets import HeadsetManager
+
+log = logging.getLogger(__name__)
+
+MAX_BODY = 1024
+
+
+class StatusPage:
+    def __init__(self, manager: HeadsetManager, host: str, port: int):
+        self.manager = manager
+        page = files("neurocinema").joinpath("static/status.html").read_bytes()
+        handler = _make_handler(manager, page)
+        self.server = ThreadingHTTPServer((host, port), handler)
+        self.server.daemon_threads = True
+        self.address = f"http://{host}:{self.server.server_address[1]}"
+        self._thread = threading.Thread(target=self.server.serve_forever, name="status-page", daemon=True)
+
+    def start(self) -> None:
+        self._thread.start()
+        log.info("status page on %s", self.address)
+
+    def close(self) -> None:
+        self.server.shutdown()
+        self.server.server_close()
+
+
+def _make_handler(manager: HeadsetManager, page: bytes):
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, fmt, *args):  # keep the engine log clean
+            log.debug("%s " + fmt, self.address_string(), *args)
+
+        def _send(self, code: int, body: bytes, ctype: str) -> None:
+            self.send_response(code)
+            self.send_header("Content-Type", ctype)
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("Cache-Control", "no-store")
+            self.end_headers()
+            self.wfile.write(body)
+
+        def _json(self, code: int, data: dict) -> None:
+            self._send(code, json.dumps(data).encode(), "application/json")
+
+        def do_GET(self):
+            if self.path in ("/", "/index.html"):
+                self._send(200, page, "text/html; charset=utf-8")
+            elif self.path == "/api/status":
+                self._json(200, manager.snapshot())
+            else:
+                self._json(404, {"error": "not found"})
+
+        def do_POST(self):
+            length = int(self.headers.get("Content-Length") or 0)
+            if length > MAX_BODY:
+                self._json(413, {"error": "too large"})
+                return
+            try:
+                body = json.loads(self.rfile.read(length) or b"{}")
+            except ValueError:
+                self._json(400, {"error": "bad json"})
+                return
+            if self.path == "/api/select":
+                label = body.get("label") if isinstance(body, dict) else None
+                if label not in {h["label"] for h in manager.snapshot().get("headsets", [])}:
+                    self._json(400, {"error": "unknown headset"})
+                    return
+                manager.submit("select", label)
+            elif self.path == "/api/release":
+                manager.submit("release")
+            elif self.path == "/api/reconnect":
+                manager.submit("reconnect")
+            else:
+                self._json(404, {"error": "not found"})
+                return
+            self._json(200, {"ok": True})
+
+    return Handler
diff --git a/b/tests/test_headsets.py b/tests/test_headsets.py
new file mode 100644
index 0000000..44f2b9e
--- /dev/null
+++ b/tests/test_headsets.py
@@ -0,0 +1,215 @@
+"""Headset manager + Bluetooth worker with simulated headsets on a fake clock."""
+
+import json
+import urllib.request
+
+import pytest
+
+from neurocinema.ble import BleWorker, FakeDriver
+from neurocinema.config import ConfigError, HeadsetsConfig, load_config
+from neurocinema.headsets import Alert, HeadsetManager, Phase
+
+REGISTRY = ["A=Muse-AAAA", "B=Muse-BBBB"]
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def __call__(self):
+        return self.t
+
+
+class Harness:
+    def __init__(self, batteries=None, lifted_after_s=3.0, **cfg):
+        self.clock = Clock()
+        self.driver = FakeDriver(
+            batteries or {"Muse-AAAA": 90.0, "Muse-BBBB": 80.0, "Muse-ZZZZ": 50.0},
+            clock=self.clock, realtime=False, lifted_after_s=lifted_after_s,
+        )
+        self.worker = BleWorker(self.driver, start_thread=False)
+        self.cfg = HeadsetsConfig(registry=cfg.pop("registry", REGISTRY), **cfg)
+        self.m = HeadsetManager(self.cfg, self.worker, clock=self.clock)
+        self.samples = []
+
+    def run(self, seconds, dt=0.05):
+        end = self.clock.t + seconds
+        while self.clock.t < end:
+            self.clock.t += dt
+            for _ in range(4):
+                self.worker.step()
+            self.samples += self.m.poll()
+
+    def use(self, label):
+        self.m.submit("select", label)
+        self.run(5.0)
+
+    @property
+    def snap(self):
+        return self.m.snapshot()
+
+
+def test_staff_swap_is_used_only_once_lifted():
+    h = Harness()
+    h.run(1.0)
+    assert h.m.phase == Phase.NO_HEADSET
+    h.m.submit("select", "A")
+    h.run(1.0)
+    assert h.m.phase == Phase.CONFIRMING
+    assert h.samples == []  # connected, but not used until lifted
+    assert not h.m.connected()
+    h.run(4.0)  # the fake headset is lifted 3 s after connecting
+    assert h.m.phase == Phase.ACTIVE
+    assert h.m.connected()
+    assert len(h.samples) > 50
+    assert h.snap["current"] == "A"
+
+
+def test_headset_not_lifted_is_released():
+    h = Harness(lifted_after_s=None, confirm_timeout_s=10.0)
+    h.m.submit("select", "B")
+    h.run(12.0)
+    assert h.m.phase == Phase.NO_HEADSET
+    assert h.m.current is None
+    assert "not picked up" in h.m.message
+    assert h.samples == []
+
+
+def test_switching_headsets_without_restart():
+    h = Harness()
+    h.use("A")
+    assert h.m.phase == Phase.ACTIVE
+    h.use("B")
+    assert h.m.phase == Phase.ACTIVE
+    assert h.m.current == "B"
+    assert h.driver._name == "Muse-BBBB"
+
+
+def test_unregistered_headset_is_listed_but_never_used():
+    h = Harness()
+    h.run(1.0)  # first scan
+    assert h.snap["unknown"] == ["Muse-ZZZZ"]
+    assert [x["label"] for x in h.snap["headsets"]] == ["A", "B"]
+    h.m.submit("select", "Z")  # not a label: ignored
+    h.run(2.0)
+    assert h.m.phase == Phase.NO_HEADSET
+
+
+def test_lost_link_reconnects_the_same_headset():
+    h = Harness(reconnect_interval_s=2.0)
+    h.use("A")
+    h.driver.link_up = False  # data stops (out of range)...
+    h.driver.switched_on.discard("Muse-AAAA")  # ...and it cannot be reached
+    h.run(6.0)
+    assert h.m.phase == Phase.RECONNECTING
+    assert not h.m.connected()
+    h.driver.switched_on.add("Muse-AAAA")  # back in range
+    h.run(3.0)
+    assert h.m.phase == Phase.ACTIVE
+    assert h.m.current == "A"
+
+
+def test_failed_connects_give_up_with_a_message():
+    h = Harness(connect_attempts=2)
+    h.driver.fail_connect.add("Muse-BBBB")
+    h.m.submit("select", "B")
+    h.run(2.0)
+    assert h.m.phase == Phase.NO_HEADSET
+    assert "Could not reach headset B" in h.m.message
+
+
+def test_battery_low_means_swap_soon():
+    h = Harness(batteries={"Muse-AAAA": 19.0, "Muse-BBBB": 80.0})
+    h.use("A")
+    assert h.m.alert(h.clock.t) == Alert.SWAP_SOON
+    assert "Swap headset A soon" in h.snap["headline"]
+    h.use("B")
+    assert h.m.alert(h.clock.t) == Alert.OK
+    assert h.snap["headline"].startswith("All good: headset B, 80 %")
+
+
+def test_time_left_estimate_from_drain():
+    h = Harness(batteries={"Muse-AAAA": 60.0, "Muse-BBBB": 80.0})
+    h.driver.drain_per_min = 1.0
+    h.use("A")
+    h.run(8 * 60.0, dt=0.5)
+    a = next(x for x in h.snap["headsets"] if x["label"] == "A")
+    assert a["battery"] == pytest.approx(52, abs=1)
+    assert a["minutes_left"] == pytest.approx(52, abs=3)
+    assert h.m.alert(h.clock.t) == Alert.OK
+    h.run(25 * 60.0, dt=0.5)  # under 30 min left
+    assert h.m.alert(h.clock.t) == Alert.SWAP_SOON
+
+
+def test_offline_after_a_minute_without_headset():
+    h = Harness(offline_after_s=60.0)
+    h.run(30.0, dt=0.5)
+    assert h.m.alert(h.clock.t) == Alert.OK
+    h.run(31.0, dt=0.5)
+    assert h.m.alert(h.clock.t) == Alert.OFFLINE
+    assert h.snap["headline"].startswith("Offline")
+
+
+def test_auto_adopt_only_with_one_registered_headset_in_range():
+    h = Harness(auto_adopt_after_s=30.0)
+    h.run(40.0, dt=0.5)
+    assert h.m.phase == Phase.NO_HEADSET  # A and B both on: do not guess
+    h.driver.switched_on.discard("Muse-BBBB")
+    h.run(25.0, dt=0.5)
+    assert h.m.phase == Phase.ACTIVE
+    assert h.m.current == "A" and h.m.auto_adopted
+
+
+def test_registry_config(tmp_path):
+    p = tmp_path / "c.toml"
+    p.write_text('[source]\nkind = "muse_direct"\n[headsets]\nregistry = ["A=Muse-41D2", "B = Muse-0C3A"]\n')
+    cfg = load_config([p])
+    assert cfg.headsets.entries() == [("A", "Muse-41D2"), ("B", "Muse-0C3A")]
+    for bad in ('["Muse-41D2"]', '["A=Muse-1", "A=Muse-2"]', '["A=Muse-1", "B=Muse-1"]'):
+        p.write_text(f"[headsets]\nregistry = {bad}\n")
+        with pytest.raises(ConfigError):
+            load_config([p])
+
+
+def test_status_page_serves_status_and_takes_commands():
+    from neurocinema.statuspage import StatusPage
+
+    h = Harness()
+    page = StatusPage(h.m, "127.0.0.1", 0)
+    page.start()
+    try:
+        status = json.load(urllib.request.urlopen(page.address + "/api/status", timeout=5))
+        assert status["phase"] == "no_headset"
+        html = urllib.request.urlopen(page.address + "/", timeout=5).read()
+        assert b"Neurocinema status" in html
+        req = urllib.request.Request(page.address + "/api/select", data=b'{"label": "B"}',
+                                     headers={"Content-Type": "application/json"})
+        assert json.load(urllib.request.urlopen(req, timeout=5)) == {"ok": True}
+        bad = urllib.request.Request(page.address + "/api/select", data=b'{"label": "Z"}')
+        with pytest.raises(urllib.error.HTTPError):
+            urllib.request.urlopen(bad, timeout=5)
+    finally:
+        page.close()
+    h.run(1.0)
+    assert h.m.current == "B"
+
+
+def test_threaded_worker_end_to_end():
+    """Real thread, real time, simulated headsets: the engine sees samples."""
+    import time
+
+    driver = FakeDriver({"Muse-AAAA": 90.0}, lifted_after_s=0.3)
+    worker = BleWorker(driver)
+    m = HeadsetManager(HeadsetsConfig(registry=["A=Muse-AAAA"]), worker)
+    try:
+        m.submit("select", "A")
+        got = []
+        deadline = time.monotonic() + 5.0
+        while time.monotonic() < deadline and len(got) < 40:
+            got += m.poll()
+            time.sleep(0.02)
+        assert m.phase == Phase.ACTIVE
+        assert len(got) >= 40
+        assert m.connected()
+    finally:
+        m.close()
